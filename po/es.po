# Pubsplash interface translations.
#
# This file is generated by the `gen-po` dev tool:
#   cargo run --bin gen-po
# It rescans the source for `t!`/`tn!` calls and `help.toml` for context-help
# prose, adds anything new with an empty translation, and preserves every
# translation already written. Messages that have left the source are kept as
# commented-out `#~` entries rather than deleted.
#
# The msgid IS the English text the app would otherwise show, so an empty
# msgstr is not a bug: it simply leaves that string in English. Translate at
# your own pace and nothing breaks.
#
# `{name}` placeholders are substituted at runtime. Keep every placeholder that
# appears in the msgid, spelled exactly the same -- but you are free to move
# them, which is the whole reason they are named rather than positional.
#
# A `msgctxt` line is the help-id of the control a message belongs to.
msgid ""
msgstr ""
"Project-Id-Version: pubsplash\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Context help for the Running applications list.
#: help.toml
msgctxt "dialog.appPicker.list"
msgid ""
"Arrow up and down through the applications you can capture. Each entry "
"gives the application's name followed by its program file. Press ENTER "
"or use the Select button to capture the highlighted one."
msgstr ""

#. Context help for the Refresh the application list button.
#: help.toml
msgctxt "dialog.appPicker.refresh"
msgid ""
"Look for applications again. Use this after starting an application, or "
"after playing something in one, so that it shows up in the list."
msgstr ""

#. Context help for the Select highlighted application button.
#: help.toml
msgctxt "dialog.appPicker.select"
msgid "Capture the application highlighted in the list and close this dialog."
msgstr ""

#. Context help for the Only show apps that have played sound checkbox.
#: help.toml
msgctxt "dialog.appPicker.soundOnly"
msgid ""
"When checked, the list only offers applications that have played sound "
"since they started, which is usually a much shorter list. Uncheck it to "
"see every open application, including ones that have not made a sound "
"yet."
msgstr ""

#. Context help for the Type an application name button.
#: help.toml
msgctxt "dialog.appPicker.typeName"
msgid ""
"Type a program name by hand, for an application that is not running "
"yet. The source stays silent until that program starts, then picks it "
"up on its own."
msgstr ""

#. Context help for the Full chat message text.
#: help.toml
msgctxt "dialog.chatView.text"
msgid ""
"Arrow up and down through this list to view chats. Home jumps to the "
"oldest message while END jumps to the most recent one."
msgstr ""

#. Context help for the New service type selector.
#: help.toml
msgctxt "dialog.connect.addServiceType"
msgid ""
"Choose whether the new service profile is an Audiopub service or a "
"direct Icecast service."
msgstr ""

#. Context help for the Add service button.
#: help.toml
msgctxt "dialog.connect.addSite"
msgid ""
"Add a new streaming service profile. Choose Audiopub for an Audiopub "
"site, or Icecast for direct source streaming."
msgstr ""

#. Context help for the Connect or disconnect button.
#: help.toml
msgctxt "dialog.connect.connectButton"
msgid ""
"Connects to the selected service. Audiopub services log in with the "
"URL, email, and password. Icecast services are armed from the saved "
"server, mount, username, and password, then connect to Icecast when you "
"start streaming. Once connected, this button changes to Disconnect."
msgstr ""

#. Context help for the Email address for the selected service.
#: help.toml
msgctxt "dialog.connect.email"
msgid ""
"Type the email address you use to log in to the selected Audiopub "
"service."
msgstr ""

#. Context help for the Listener count URL for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastListeners"
msgid ""
"Optional. Type where your listeners actually are, if that is not the "
"mount you publish to. Leave this blank to count the mount point above. "
"Type a mount name such as stream.mp3 to count a different mount on the "
"same server, or a full listen URL such as "
"http://radio.example.com:8000/stream.mp3 to count one somewhere else. A "
"server with no mount after it counts everyone on that server. Use this "
"when a relay, such as Liquidsoap, takes your mount and republishes it "
"under another name."
msgstr ""

#. Context help for the Icecast mount point for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastMount"
msgid ""
"Type the Icecast mount point for this service. A leading slash is "
"optional."
msgstr ""

#. Context help for the Icecast password for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastPassword"
msgid "Type the Icecast source password or stream key for this service."
msgstr ""

#. Context help for the Icecast port for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastPort"
msgid "Type the Icecast port number. The default is 8000."
msgstr ""

#. Context help for the Icecast server for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastServer"
msgid "Type the Icecast server host or address, without the port."
msgstr ""

#. Context help for the Icecast username for the selected service.
#: help.toml
msgctxt "dialog.connect.icecastUsername"
msgid "Type the Icecast source username. If left blank, Pubsplash uses source."
msgstr ""

#. Context help for the Streaming service nickname.
#: help.toml
msgctxt "dialog.connect.nickname"
msgid ""
"Type a short name for this service as it should appear in the services "
"list."
msgstr ""

#. Context help for the Password for the selected service.
#: help.toml
msgctxt "dialog.connect.password"
msgid "Type the password you use to log in to the selected Audiopub service."
msgstr ""

#. Context help for the Remove service button.
#: help.toml
msgctxt "dialog.connect.removeSite"
msgid ""
"This deletes the selected service profile. The main Audiopub service "
"cannot be removed."
msgstr ""

#. Context help for the Rename service button.
#: help.toml
msgctxt "dialog.connect.renameSite"
msgid ""
"Rename the selected service profile. The main Audiopub service cannot "
"be renamed."
msgstr ""

#. Context help for the RTMP stream key for the selected service.
#: help.toml
msgctxt "dialog.connect.rtmpKey"
msgid ""
"Type the stream key for this service. YouTube shows it in YouTube "
"Studio, under Go live, beside the stream URL. Treat it like a password: "
"anyone who has it can broadcast to your channel."
msgstr ""

#. Context help for the RTMP ingest URL for the selected service.
#: help.toml
msgctxt "dialog.connect.rtmpUrl"
msgid ""
"Type the RTMP address to publish to, without the stream key. YouTube's "
"is rtmp://a.rtmp.youtube.com/live2, and its backup is "
"rtmp://b.rtmp.youtube.com/live2?backup=1. Pubsplash adds the stream key "
"below onto the end for you. Any other RTMP server works here too."
msgstr ""

#. Context help for the Service type selector.
#: help.toml
msgctxt "dialog.connect.serviceType"
msgid ""
"Choose whether the selected non-main service is Audiopub or Icecast. "
"The main Audiopub service shows this selector disabled because its type "
"is fixed."
msgstr ""

#. Context help for the Configured streaming services list.
#: help.toml
msgctxt "dialog.connect.siteList"
msgid ""
"Use the arrow keys to select a streaming service, then tab to its "
"settings. Audiopub is already here for you; add more Audiopub or "
"Icecast services with the Add service button."
msgstr ""

#. Context help for the Audiopub URL for the selected service.
#: help.toml
msgctxt "dialog.connect.url"
msgid ""
"Type the full Audiopub service URL, starting with http or https. The "
"main Audiopub service keeps its built-in URL."
msgstr ""

#. Context help for the YouTube channel or video to read chat from.
#: help.toml
msgctxt "dialog.connect.youtubeChannel"
msgid ""
"Optional. Type your YouTube channel handle, such as @yourchannel, and "
"Pubsplash will read the chat of whatever you have live. A channel "
"address, a video address, or a video id works too, but a handle is the "
"one to use: it never changes, so it keeps working for every broadcast. "
"Leave this blank if this is not a YouTube service or you do not want "
"chat. Chat can only be read, not sent."
msgstr ""

#. Context help for the Still image sent as the video track.
#: help.toml
msgctxt "dialog.connect.youtubeImage"
msgid ""
"Optional. Type or choose a picture to send as the video. YouTube will "
"not accept a stream with no video at all, so Pubsplash sends a still "
"picture alongside your audio. Leave this blank to send a plain dark "
"frame instead."
msgstr ""

#. Context help for the Choose still image button.
#: help.toml
msgctxt "dialog.connect.youtubeImageBrowse"
msgid ""
"Opens a file picker to choose the still picture sent as the video. The "
"picture is centred on a 1280 by 720 frame, so any size or shape will do."
msgstr ""

#. Context help for the Capture from combo box.
#: help.toml
msgctxt "dialog.desktopAudioSource.device"
msgid ""
"Chooses where this Desktop Audio source gets its sound from. \"All "
"output devices (Pubsplash excluded)\" is the usual choice: it captures "
"everything your computer plays, on every device at once, apart from "
"Pubsplash's own speech, sound cues and monitoring. Picking a single "
"output device instead captures only what is played to that one device, "
"but it captures everything on it with nothing left out, so it cannot be "
"the device Pubsplash itself plays out of. If you pick that one, "
"Pubsplash will say so and leave this window open so you can choose "
"another; you can change which device Pubsplash plays out of on the "
"Audio tab in Preferences."
msgstr ""

#. Context help for the FFmpeg download progress bar.
#: help.toml
msgctxt "dialog.ffmpeg.progress"
msgid ""
"How much of FFmpeg has been downloaded, as a percentage. The download "
"is about 110 megabytes."
msgstr ""

#. Context help for the FFmpeg download status text.
#: help.toml
msgctxt "dialog.ffmpeg.status"
msgid ""
"What the download is doing now. Read only; it does not read itself out "
"as it changes, so check it here when you want to know."
msgstr ""

#. Context help for the Bypass this plugin checkbox.
#: help.toml
msgctxt "dialog.fxEditor.bypass"
msgid ""
"When checked, the selected plugin is bypassed, and will not output "
"anything."
msgstr ""

#. Context help for the Close plugin interface button.
#: help.toml
msgctxt "dialog.fxEditor.close"
msgid "This will close the native interface of the selected VST plugin."
msgstr ""

#. Context help for the Move focus into the plugin's own interface button.
#: help.toml
msgctxt "dialog.fxEditor.focusPlugin"
msgid "This attempts to focus the plugin's native interface."
msgstr ""

#. Context help for the Open accessible parameters dialog button.
#: help.toml
msgctxt "dialog.fxEditor.parameters"
msgid ""
"Opens a dialog that allows editing of all the plugin's parameters it "
"exposes to automation."
msgstr ""

#. Context help for the Filter parameters by name box.
#: help.toml
msgctxt "dialog.fxParams.filter"
msgid ""
"Filters parameters by a given name. For instance, if you're using a "
"voice doubler, and you can pan each of the cloned voices, typing pan "
"into the filter box would show only parameters whose name contains pan."
msgstr ""

#. Context help for the Plugin parameter chooser.
#: help.toml
msgctxt "dialog.fxParams.parameter"
msgid ""
"Use arrows and first-letter navigation to navigate to a parameter, then "
"press tab to enter the slider for menipulating it."
msgstr ""

#. Context help for the Show unnamed parameters checkbox.
#: help.toml
msgctxt "dialog.fxParams.showUnnamed"
msgid "Show or hide unnamed parameters."
msgstr ""

#. Context help for the Selected parameter value slider.
#: help.toml
msgctxt "dialog.fxParams.value"
msgid ""
"Use arrow keys as well as page up, page down, home and end to adjust "
"the parameter. You should hear real values as reported by the plugin "
"where possible, for instance, 300ms for a delay value."
msgstr ""

#. Context help for the Binding action choice.
#: help.toml
msgctxt "dialog.keybind.action"
msgid ""
"What the shortcut will do. Some actions need to know which scene, "
"source or bus they apply to; choosing one of those adds a further list "
"right after this one."
msgstr ""

#. Context help for the Binding category choice.
#: help.toml
msgctxt "dialog.keybind.category"
msgid ""
"Which group of actions to choose from: streaming, scenes, monitoring or "
"muting. Changing this refills the action list below it."
msgstr ""

#. Context help for the Global binding checkbox.
#: help.toml
msgctxt "dialog.keybind.global"
msgid ""
"When checked, this shortcut works anywhere in Windows, not only while "
"Pubsplash is in front, unless some other application swallows it first. "
"A global shortcut must include CTRL, ALT or SHIFT, or be a function "
"key: on its own a plain letter or digit would be taken away from "
"everything you type in."
msgstr ""

#. Context help for the Shortcut capture field.
#: help.toml
msgctxt "dialog.keybind.shortcut"
msgid ""
"While this field has focus, press the key combination you want and it "
"is read back to you. ESCAPE or DELETE clears it again. TAB and SHIFT "
"plus TAB are left alone so you can always move on, which means they "
"cannot themselves be bound. F1 and F6 are refused as well: F1 speaks "
"this help and F6 moves between the lists on a tab."
msgstr ""

#. Context help for the Binding scene, source, bus or media player choice.
#: help.toml
msgctxt "dialog.keybind.specifier"
msgid ""
"Which scene, source, bus or media player the action applies to. This "
"appears only for actions that need one, and disappears again when you "
"pick an action that does not. A source shortcut runs against the scene "
"that is live when you press it, so it does nothing while you are in a "
"scene that has no source by that name."
msgstr ""

#. Context help for the Delete selected chain button.
#: help.toml
msgctxt "dialog.loadChain.delete"
msgid "Remove the selected FX chain."
msgstr ""

#. Context help for the Saved FX chains list.
#: help.toml
msgctxt "dialog.loadChain.list"
msgid "A list of saved FX chains you can apply to the selected bus."
msgstr ""

#. Context help for the Load selected chain button.
#: help.toml
msgctxt "dialog.loadChain.load"
msgid "Load the selected FX chain and apply it to the bus you're working with."
msgstr ""

#. Context help for the Mastodon authorization status.
#: help.toml
msgctxt "dialog.mastodonAuth.status"
msgid ""
"Says what the authorization is waiting for. Pubsplash opens your "
"browser so you can sign in to your Mastodon server and approve it; this "
"window closes on its own once you have. Use Cancel, or press ESCAPE, to "
"give up."
msgstr ""

#. Context help for the Token help button on the resumed stream post.
#: help.toml
msgctxt "dialog.mastodonResume.help"
msgid ""
"Lists the tokens you can put in this post and what each one is replaced "
"with."
msgstr ""

#. Context help for the Resumed stream post.
#: help.toml
msgctxt "dialog.mastodonResume.text"
msgid ""
"What to post about resuming this stream. It starts out filled in and "
"selected, so you can type straight over it. Tokens in curly braces work "
"here exactly as they do in a saved template; press Help for the list. "
"The hashtag PubsplashStreamInfo is added to the end for you."
msgstr ""

#. Context help for the Token help button.
#: help.toml
msgctxt "dialog.mastodonTemplate.help"
msgid ""
"Lists the tokens you can put in a template and what each one is "
"replaced with."
msgstr ""

#. Context help for the Announcement type selector.
#: help.toml
msgctxt "dialog.mastodonTemplate.kind"
msgid ""
"Choose when this template is used. Start of stream templates go out "
"when a stream begins; stream continuation templates are the ones used "
"for the periodic still-streaming posts. If you have written several of "
"a type, Pubsplash picks one of them at random each time."
msgstr ""

#. Context help for the Template text input.
#: help.toml
msgctxt "dialog.mastodonTemplate.text"
msgid ""
"The wording of the announcement. Put a token in curly braces anywhere "
"you want the real value, for example: I am live at {url}. Press Help "
"for the list of tokens. If a token is misspelled, or a brace is left "
"unclosed, you are told which one when you choose OK and brought "
"straight back here with your text still in place. The hashtag "
"PubsplashStreamInfo is added to the end of every post for you."
msgstr ""

#. Context help for the Template token reference.
#: help.toml
msgctxt "dialog.mastodonTokens.text"
msgid ""
"The tokens you can use in a template, one per line, each with what it "
"is replaced with. You can select text here and copy it with CONTROL "
"plus C."
msgstr ""

#. Context help for the Calibrate ducking threshold button.
#: help.toml
msgctxt "dialog.mediaPlayerSource.calibrate"
msgid ""
"Sets the level above for you. Press this and talk normally for five "
"seconds, at the volume you actually broadcast at, and Pubsplash "
"measures the very signal the ducking watches, then puts the level a "
"little way underneath what it heard. It listens to the sources in your "
"live scene, through their volume sliders and mutes, so the microphone "
"you are calibrating has to be in that scene and unmuted. When it has "
"finished it tells you the level it chose, and the slider above moves to "
"it. If nothing loud enough to be a voice was heard, it says so and "
"nothing is changed. Nothing is saved until you choose OK."
msgstr ""

#. Context help for the Ducking checkbox.
#: help.toml
msgctxt "dialog.mediaPlayerSource.duck"
msgid ""
"When checked, the music turns itself down whenever any other source in "
"this scene is making sound, and comes back up about a second after it "
"stops. Your microphone and your text-to-speech are both other sources, "
"so this is what lets you talk over the music without touching a fader. "
"Making a sound means a real signal rather than the hiss of an open "
"microphone in a quiet room, so an idle microphone does not hold the "
"music down. Other media players do not count either, so two of them "
"never fight each other. The level it drops to is the next control."
msgstr ""

#. Context help for the Turned-down level slider.
#: help.toml
msgctxt "dialog.mediaPlayerSource.duckLevel"
msgid ""
"How loud the music is while it is turned down, as a percentage of this "
"source's own volume slider. Twenty-five percent means a quarter of "
"whatever the fader is set to, which leaves the music audible underneath "
"you. Zero silences it completely while anything else is playing. This "
"has no effect unless the checkbox above is checked."
msgstr ""

#. Context help for the Ducking threshold slider.
#: help.toml
msgctxt "dialog.mediaPlayerSource.duckThreshold"
msgid ""
"How loud another source has to get before the music is turned down, in "
"decibels below full scale. Minus sixty is almost anything, minus ten is "
"only a shout, and the default of minus thirty is the level of somebody "
"deliberately talking, far enough above a breath across the microphone "
"or a knock on the desk that neither turns your music down. Lower it if "
"a normal sentence does not duck the music, raise it if something in the "
"room does, or press the Calibrate button below and let Pubsplash "
"measure your own voice. This has no effect unless the ducking checkbox "
"is checked."
msgstr ""

#. Context help for the Media player folder box.
#: help.toml
msgctxt "dialog.mediaPlayerSource.folder"
msgid ""
"The folder this source plays, including everything in its subfolders. "
"Type the full path or use the browse button. Pubsplash plays MP3, M4A, "
"AAC, FLAC, OGG, WAV, AIFF and a few others; anything it cannot decode, "
"such as Opus or WMA, is ignored. The folder is read again every few "
"minutes, so music you add during a session joins in without restarting "
"anything. Until this is filled in, the source stays silent."
msgstr ""

#. Context help for the Shuffle checkbox.
#: help.toml
msgctxt "dialog.mediaPlayerSource.shuffle"
msgid ""
"When checked, the folder is played in a random order, and every file is "
"played once before any of them repeats. It is reshuffled each time it "
"runs out, and never starts a new round with the track that just "
"finished. Unchecked plays the folder in filename order instead, over "
"and over."
msgstr ""

#. Context help for the Apply chain with available plugins button.
#: help.toml
msgctxt "dialog.missingPlugins.apply"
msgid ""
"If Pubsplash determines that you don't have all of the plugins this "
"chain uses, you can still apply the chain, minus those plugins."
msgstr ""

#. Context help for the Missing plugins list.
#: help.toml
msgctxt "dialog.missingPlugins.list"
msgid "Shows the list of plugins you lack to apply this FX chain in full."
msgstr ""

#. Context help for the Archive streams by default checkbox.
#: help.toml
msgctxt "dialog.preferences.archive.archiveDefault"
msgid ""
"When this box is checked, streams will be archived on Audiopub by "
"default. You can still uncheck the box under file > set stream info if "
"you don't want a particular stream archived."
msgstr ""

#. Context help for the Browse for recording folder button.
#: help.toml
msgctxt "dialog.preferences.archive.browse"
msgid ""
"This brings up a standard windows file browser that allows you to "
"select the folder that Pubsplash will save your local recordings to."
msgstr ""

#. Context help for the Record streams by default checkbox.
#: help.toml
msgctxt "dialog.preferences.archive.recordDefault"
msgid ""
"When this box is checked, streams will automatically be recorded and "
"saved to disk. You can still uncheck the box under file > set stream "
"info if you don't want a particular stream to be recorded."
msgstr ""

#. Context help for the Recording folder path input.
#: help.toml
msgctxt "dialog.preferences.archive.recordingFolder"
msgid ""
"Type the path where you'd like your local recordings to be saved to, or "
"use the browse button to pick a folder using a standard Windows folder "
"picker."
msgstr ""

#. Context help for the Choose FFmpeg button.
#: help.toml
msgctxt "dialog.preferences.audio.ffmpegBrowse"
msgid ""
"Opens a file picker to choose ffmpeg.exe. Use this if you already have "
"FFmpeg somewhere Pubsplash does not find on its own."
msgstr ""

#. Context help for the Download FFmpeg button.
#: help.toml
msgctxt "dialog.preferences.audio.ffmpegDownload"
msgid ""
"Downloads FFmpeg from gyan.dev, the Windows build ffmpeg.org points at, "
"and checks it against the checksum published beside it. About 110 "
"megabytes. Clear the FFmpeg location box first, or the file it names is "
"used instead. Closing Preferences cancels the download."
msgstr ""

#. Context help for the FFmpeg location box.
#: help.toml
msgctxt "dialog.preferences.audio.ffmpegPath"
msgid ""
"Optional. Type or choose the full path to ffmpeg.exe if you want a "
"particular copy used. Leave this blank and Pubsplash searches the copy "
"it downloaded, then your PATH, which is where an FFmpeg installed by "
"winget, Chocolatey or Scoop ends up."
msgstr ""

#. Context help for the FFmpeg status text.
#: help.toml
msgctxt "dialog.preferences.audio.ffmpegStatus"
msgid ""
"Which FFmpeg Pubsplash will use, and whether it can do the job. FFmpeg "
"is needed only for streaming to YouTube, because YouTube takes H.264 "
"video and AAC audio and Pubsplash produces neither on its own. Read "
"only."
msgstr ""

#. Context help for the Output device combo box.
#: help.toml
msgctxt "dialog.preferences.audio.outputDevice"
msgid ""
"Chooses which playback device Pubsplash plays out of. Everything "
"Pubsplash plays for you goes here: sources you are monitoring, "
"text-to-speech, and sound cues such as the startup sound. It is not "
"what your listeners hear, and changing it does not affect your stream. "
"\"Default output device (follow system)\" uses whatever Windows is "
"currently using, so it moves when you plug in a headset; picking a "
"device by name keeps Pubsplash on that one. If a Desktop Audio source "
"captures the device you choose here, Pubsplash tells you and that "
"source falls back to capturing every device, so its own audio can never "
"end up in your stream."
msgstr ""

#. Context help for the Play a test sound button.
#: help.toml
msgctxt "dialog.preferences.audio.testSound"
msgid ""
"Plays the startup sound once out of the device selected above, so you "
"can check you have picked the right one without starting a stream. "
"Nothing is recorded or sent to listeners."
msgstr ""

#. Context help for the Check for updates now button.
#: help.toml
msgctxt "dialog.preferences.general.checkNow"
msgid ""
"Asks GitHub straight away whether a newer version of Pubsplash exists, "
"without waiting for the next time you start the app. Unlike the "
"automatic check, this one always answers: if you already have the "
"newest version, it says so. If there is a newer one, Pubsplash asks "
"whether you'd like it before downloading anything."
msgstr ""

#. Context help for the Check for updates on startup checkbox.
#: help.toml
msgctxt "dialog.preferences.general.checkOnStart"
msgid ""
"When this box is checked, Pubsplash asks GitHub once each time it "
"starts whether a newer version exists. If there isn't one, or GitHub "
"can't be reached, nothing is said at all. If there is, Pubsplash asks "
"whether you'd like to download and install it; nothing is downloaded or "
"replaced unless you say yes. The check is skipped entirely while you "
"are streaming or recording."
msgstr ""

#. Context help for the Add binding button.
#: help.toml
msgctxt "dialog.preferences.keybinds.add"
msgid ""
"Opens a dialog where you choose an action and press the keys you want "
"to run it with."
msgstr ""

#. Context help for the Edit binding button.
#: help.toml
msgctxt "dialog.preferences.keybinds.edit"
msgid ""
"Opens the same dialog for the action highlighted in the list, filled in "
"with whatever it is bound to now, so you can change the keys or make "
"the shortcut global."
msgstr ""

#. Context help for the Keybinds list.
#: help.toml
msgctxt "dialog.preferences.keybinds.list"
msgid ""
"Every action you can give a keyboard shortcut to. Arrow up and down "
"through them. Each row gives the action, then the keys bound to it, or "
"Unassigned when it has none, and says global when the shortcut works "
"even while another application is in front. Press DELETE, or use the "
"remove binding button, to take a shortcut away. Streaming starts and "
"stops with F9 and recording with F10 until you change them."
msgstr ""

#. Context help for the Remove binding button.
#: help.toml
msgctxt "dialog.preferences.keybinds.remove"
msgid ""
"Takes the shortcut away from the highlighted action, leaving the action "
"itself alone. The DELETE key in the list does the same thing."
msgstr ""

#. Context help for the Reset keybinds to defaults button.
#: help.toml
msgctxt "dialog.preferences.keybinds.reset"
msgid ""
"Throws away every shortcut you have made and puts back the two "
"Pubsplash ships with, F9 for streaming and F10 for recording. You are "
"asked to confirm first."
msgstr ""

#. Context help for the Compress logs button.
#: help.toml
msgctxt "dialog.preferences.logging.compress"
msgid ""
"Packages the log files and any crash reports into a single ZIP file, "
"and asks you where to save it with a standard Windows save box. This is "
"the file to attach when you report a problem. Pubsplash stops logging "
"for the moment it takes, so that the log of the session you are in "
"right now is closed off and goes into the archive complete rather than "
"with its last few lines missing; logging carries straight on "
"afterwards. Nothing else is included: no passwords, no API keys, and "
"none of your settings."
msgstr ""

#. Context help for the Log level choice.
#: help.toml
msgctxt "dialog.preferences.logging.level"
msgid ""
"How much detail Pubsplash writes to its log file. Info, the setting it "
"ships with, records the things that matter: what connected, what "
"failed, what you started and stopped. Debug and trace add a great deal "
"more, and are worth turning on when you are chasing a problem and have "
"been asked for a log; trace in particular writes constantly while audio "
"is running, so put it back to info afterwards. Error and warn record "
"less than info, and off writes nothing at all. The change takes effect "
"at once, and is remembered. If a PUBSPLASH_LOG environment variable is "
"set, it fixes the level for the run and this box is disabled."
msgstr ""

#. Context help for the Open logs folder button.
#: help.toml
msgctxt "dialog.preferences.logging.openFolder"
msgid ""
"Opens the folder the log files are written to in Windows Explorer. The "
"newest one is called pubsplash_rCURRENT.log and is the one being "
"written to right now; the numbered ones beside it are older. If you are "
"collecting a log to send to somebody, the Compress logs button is the "
"easier way, since it gathers all of them and the crash reports in one "
"go."
msgstr ""

#. Context help for the Add template button.
#: help.toml
msgctxt "dialog.preferences.mastodon.addTemplate"
msgid ""
"Write a new announcement template. You choose whether it is for the "
"start of a stream or for the still-streaming posts, then type the "
"wording."
msgstr ""

#. Context help for the Authorize with Mastodon button.
#: help.toml
msgctxt "dialog.preferences.mastodon.authorize"
msgid ""
"Link your Mastodon account. Pubsplash opens your browser at the server "
"named above so you can sign in and approve it, then stores the "
"authorization. Nothing is posted until you also turn an announcement on."
msgstr ""

#. Context help for the Edit template button.
#: help.toml
msgctxt "dialog.preferences.mastodon.editTemplate"
msgid "Change the template highlighted in the list."
msgstr ""

#. Context help for the Still-streaming post interval choice.
#: help.toml
msgctxt "dialog.preferences.mastodon.interval"
msgid ""
"How long to wait between still-streaming posts. The clock starts when "
"the stream goes live, so on the hourly setting the first one goes out "
"an hour after you start. Available only while still-streaming posts are "
"turned on."
msgstr ""

#. Context help for the Make periodic still-streaming Mastodon posts checkbox.
#: help.toml
msgctxt "dialog.preferences.mastodon.periodic"
msgid ""
"When checked, Pubsplash keeps posting a reminder that you are still on "
"the air while a stream runs, using the interval in the list after this "
"box. This only sets the starting state of the matching box in the Set "
"stream info dialog; you can still turn it off for one stream there."
msgstr ""

#. Context help for the Post to Mastodon when I start a new stream checkbox.
#: help.toml
msgctxt "dialog.preferences.mastodon.postOnStart"
msgid ""
"When checked, Pubsplash posts to Mastodon once a new stream is live. "
"This only sets the starting state of the matching box in the Set stream "
"info dialog; you can still turn it off for one stream there."
msgstr ""

#. Context help for the Remove template button.
#: help.toml
msgctxt "dialog.preferences.mastodon.removeTemplate"
msgid ""
"Delete the template highlighted in the list. You can also press DELETE "
"in the list. Deleting all of them is safe: Pubsplash falls back on its "
"own wording."
msgstr ""

#. Context help for the Mastodon server input.
#: help.toml
msgctxt "dialog.preferences.mastodon.server"
msgid ""
"The Mastodon server your account is on, such as mastodon dot social. "
"Type just the host name; Pubsplash works out the rest. Fill this in "
"before choosing Authorize."
msgstr ""

#. Context help for the Linked Mastodon account.
#: help.toml
msgctxt "dialog.preferences.mastodon.status"
msgid "Which account is linked, if any. Read-only."
msgstr ""

#. Context help for the Mastodon announcement templates list.
#: help.toml
msgctxt "dialog.preferences.mastodon.templateList"
msgid ""
"The announcement templates you have written. Each row gives the type, a "
"colon, and the wording. Start of stream templates come first, then the "
"stream continuation ones. Arrow up and down to choose one, then use "
"Edit or Remove. If you have more than one of a type, Pubsplash picks "
"one of them at random each time it posts."
msgstr ""

#. Context help for the Unlink the Mastodon account button.
#: help.toml
msgctxt "dialog.preferences.mastodon.unlink"
msgid ""
"Forget the linked Mastodon account. Pubsplash stops posting and asks "
"the server to cancel the authorization. Available only while an account "
"is linked."
msgstr ""

#. Context help for the Import sound pack button.
#: help.toml
msgctxt "dialog.preferences.sounds.importPack"
msgid ""
"Opens a file dialog to pick a compiled sound pack, a dot pspack file. "
"Pubsplash keeps its own copy, so you can move or delete the file you "
"picked afterwards, and the pack is added to the sound pack list and "
"becomes the one in use."
msgstr ""

#. Context help for the Sound pack choice.
#: help.toml
msgctxt "dialog.preferences.sounds.pack"
msgid ""
"The sound pack every cue plays from: the startup and shut-down sounds, "
"and every Sound Events source. Built-in default is the pack that ships "
"inside Pubsplash; anything else you have imported is listed after it. "
"Arrow through the list freely, the pack you land on is loaded a moment "
"after you stop, or straight away if you tab out of the list."
msgstr ""

#. Context help for the Play the shut-down sound checkbox.
#: help.toml
msgctxt "dialog.preferences.sounds.playShutdown"
msgid ""
"When checked, Pubsplash plays a short sound as it closes, and waits for "
"it to finish before the window goes away. Uncheck it for a silent, "
"immediate exit. Only you hear this sound; it is never sent to the "
"stream."
msgstr ""

#. Context help for the Play the startup sound checkbox.
#: help.toml
msgctxt "dialog.preferences.sounds.playStartup"
msgid ""
"When checked, Pubsplash plays a short sound as it launches, so you know "
"it is loading. Only you hear this sound; it is never sent to the stream."
msgstr ""

#. Context help for the Preview sound pack button.
#: help.toml
msgctxt "dialog.preferences.sounds.previewPack"
msgid ""
"Opens a window listing every sound event Pubsplash has, so you can hear "
"what the chosen pack plays for each one. Only you hear these; a preview "
"never reaches the stream or a recording. This button has no ALT "
"shortcut, because every letter of the word is already spoken for "
"elsewhere in Preferences."
msgstr ""

#. Context help for the Remove sound pack button.
#: help.toml
msgctxt "dialog.preferences.sounds.removePack"
msgid ""
"Deletes Pubsplash's copy of the sound pack chosen in the list, after "
"asking you to confirm. The cues go back to the built-in default pack. "
"The dot pspack file you imported from is left alone. This button is "
"unavailable while Built-in default is chosen."
msgstr ""

#. Context help for the AWS access key ID.
#: help.toml
msgctxt "dialog.preferences.speech.awsId"
msgid ""
"Enter a draft AWS access key ID together with the secret and region, "
"then press Validate. Both credentials are saved only after Polly "
"discovery succeeds."
msgstr ""

#. Context help for the AWS region.
#: help.toml
msgctxt "dialog.preferences.speech.awsRegion"
msgid "The AWS region to send Polly requests to, for example us-east-1."
msgstr ""

#. Context help for the AWS secret access key.
#: help.toml
msgctxt "dialog.preferences.speech.awsSecret"
msgid ""
"Your AWS secret access key. It is encrypted for your Windows account "
"before being saved."
msgstr ""

#. Context help for the Azure subscription key.
#: help.toml
msgctxt "dialog.preferences.speech.azureKey"
msgid ""
"Type or paste a draft Azure Speech key and region, then press Validate. "
"Both are saved only after Azure returns its voice catalog successfully."
msgstr ""

#. Context help for the Azure region.
#: help.toml
msgctxt "dialog.preferences.speech.azureRegion"
msgid ""
"The Azure region your Speech resource lives in, for example eastus. "
"Azure will not answer without it."
msgstr ""

#. Context help for the ElevenLabs API key.
#: help.toml
msgctxt "dialog.preferences.speech.elevenlabsKey"
msgid ""
"Type or paste a draft ElevenLabs API key, then press Validate. Failed "
"validation or closing Preferences keeps the last validated key and "
"cached catalog."
msgstr ""

#. Context help for the Speech engine choice.
#: help.toml
msgctxt "dialog.preferences.speech.engine"
msgid ""
"Choose which speech engine's settings to fill in. Everything below this "
"box belongs to the engine named here, so you only tab through the one "
"you are working on. SAPI 5, Microsoft Edge and Google Translate need "
"nothing filled in. This is only about entering credentials; you pick "
"the engine a source actually speaks with in that source's own dialog, "
"on the Scenes tab. Pubsplash reopens this tab on whichever engine you "
"were last looking at."
msgstr ""

#. Context help for the Google Cloud API key.
#: help.toml
msgctxt "dialog.preferences.speech.googleKey"
msgid ""
"Type or paste a draft Google Cloud Text to Speech API key, then press "
"Validate. It is saved only after Google returns its voice catalog "
"successfully."
msgstr ""

#. Context help for the Maximum message length.
#: help.toml
msgctxt "dialog.preferences.speech.maxChars"
msgid ""
"The longest chat message that will be spoken. Longer messages are cut "
"short rather than skipped. This keeps one very long message from tying "
"up the speech engine, and keeps costs down on the paid services."
msgstr ""

#. Context help for the Minimum request interval.
#: help.toml
msgctxt "dialog.preferences.speech.minInterval"
msgid ""
"The shortest gap between two requests to a speech service, in "
"milliseconds. Raising it spreads out a burst of chat messages so a busy "
"stream does not run up a bill or hit a rate limit."
msgstr ""

#. Context help for the OpenAI API key.
#: help.toml
msgctxt "dialog.preferences.speech.openaiKey"
msgid ""
"Type or paste a draft OpenAI API key, then press Validate. The saved "
"key and voice catalog change only after OpenAI accepts the draft; "
"closing Preferences or a failed validation keeps the last validated key."
msgstr ""

#. Context help for the Star server URL.
#: help.toml
msgctxt "dialog.preferences.speech.starHost"
msgid ""
"The WebSocket address of your Star coagulator, for example ws colon "
"slash slash localhost colon 4567."
msgstr ""

#. Context help for the Add plugin folder button.
#: help.toml
msgctxt "dialog.preferences.vst.addFolder"
msgid ""
"Allows adding a folder to the list of those that will be scanned for "
"plugins when you press the scan or rescan buttons."
msgstr ""

#. Context help for the VST plugin folders list.
#: help.toml
msgctxt "dialog.preferences.vst.folderList"
msgid ""
"Use the arrow keys to review this list of folders. If you have plugins "
"that live in other folders, you may use the add button to add them to "
"this list, then initiate a scan to discover them."
msgstr ""

#. Context help for the Remove plugin folder button.
#: help.toml
msgctxt "dialog.preferences.vst.removeFolder"
msgid ""
"Removes a folder from the list of folders that will be scanned for VST "
"plugins."
msgstr ""

#. Context help for the Rescan all plugins button.
#: help.toml
msgctxt "dialog.preferences.vst.rescanAll"
msgid ""
"Discards the plugin cache and scans every folder in the list for "
"plugins. If successful, a cache is written and the plugins become "
"usable on the buses tab of the main interface."
msgstr ""

#. Context help for the Scan for new plugins button.
#: help.toml
msgctxt "dialog.preferences.vst.scanNew"
msgid ""
"Scans the list of folders for plugins, adding only those that Pubsplash "
"didn't know about before. Useful if you've recently installed plugins."
msgstr ""

#. Context help for the Cancel the scan button.
#: help.toml
msgctxt "dialog.scan.cancel"
msgid ""
"Stops the scan and throws away everything it found; the plugins you "
"already had are left as they were. ESCAPE does the same. If a plugin is "
"being loaded right now, the scan stops as soon as that one finishes or "
"is skipped, so this can take a moment to take effect."
msgstr ""

#. Context help for the Scan progress bar.
#: help.toml
msgctxt "dialog.scan.progress"
msgid ""
"How far through the scan Pubsplash is, as a percentage. It stays at "
"zero until the folders have been searched and the number of plugins is "
"known."
msgstr ""

#. Context help for the Skip the plugin being scanned button.
#: help.toml
msgctxt "dialog.scan.skip"
msgid ""
"Gives up on the plugin named in the status text and moves on to the "
"next one. ENTER does the same. Use this when a plugin is taking so long "
"that you don't think it will finish. The skipped plugin is recorded as "
"unusable and will not be tried again until you rescan all plugins."
msgstr ""

#. Context help for the Scan status text.
#: help.toml
msgctxt "dialog.scan.status"
msgid ""
"What the scan is doing right now: how many plugins are done out of how "
"many, and the name of the one being loaded. Read-only, and it does not "
"read itself out as it changes, so tab here whenever you want to know "
"where the scan has got to."
msgstr ""

#. Context help for the Date to go live on.
#: help.toml
msgctxt "dialog.schedule.date"
msgid ""
"The day the stream goes live. Today to begin with, and dates in the "
"past cannot be chosen. In advanced mode this is the day the pre-stream "
"time falls on; if your start of stream time is earlier in the day than "
"the pre-stream time, Pubsplash takes it as the following morning, so a "
"broadcast can cross midnight."
msgstr ""

#. Context help for the Scheduling mode selector.
#: help.toml
msgctxt "dialog.schedule.mode"
msgid ""
"Choose how the scheduled stream starts. Simple picks one time: "
"Pubsplash connects then, using whichever scene is active. Advanced "
"picks two: Pubsplash connects at the pre-stream time on one scene, then "
"switches to a second scene when your content is due to begin. Advanced "
"is worth using because Audio Pub can take half a minute or more to "
"start serving listeners, so connecting early on a music scene means "
"everyone arrives to a stream that is already up. Choosing Advanced adds "
"the extra time and the two scene choices below."
msgstr ""

#. Context help for the Scene to broadcast before the content starts.
#: help.toml
msgctxt "dialog.schedule.preScene"
msgid ""
"Advanced mode only. The scene Pubsplash connects on and broadcasts "
"until your content is due. Usually a scene with nothing but music or a "
"holding loop in it, so early listeners hear something and the stream is "
"proven working before you are on air. Pubsplash switches to this scene "
"just before it connects, so whatever was active is left alone until "
"then."
msgstr ""

#. Context help for the Scene to switch to when the content starts.
#: help.toml
msgctxt "dialog.schedule.startScene"
msgid ""
"Advanced mode only. The scene Pubsplash switches to at the start of "
"stream time, normally the one with your microphone and any applications "
"you are broadcasting. Pubsplash announces the switch when it happens. "
"Note that switching moves keyboard focus out of the mixer, the same as "
"switching scenes by hand does, so if you are working in the mixer at "
"that moment you will need to tab back."
msgstr ""

#. Context help for the Time the content begins and the scene switches.
#: help.toml
msgctxt "dialog.schedule.startTime"
msgid ""
"Advanced mode only. The time your actual content begins, which is when "
"Pubsplash switches from the pre-stream scene to the start of stream "
"scene. It must be later than the pre-stream time; if it is earlier in "
"the day, Pubsplash takes it as the following morning so a broadcast can "
"cross midnight. The stream is already live by then, so the switch "
"happens even if it is running late."
msgstr ""

#. Context help for the Time to connect and go live.
#: help.toml
msgctxt "dialog.schedule.time"
msgid ""
"The time Pubsplash connects to your streaming service and starts "
"sending audio. In simple mode this is when your stream begins. In "
"advanced mode it is called the pre-stream time, and it is when the "
"first scene goes out, ahead of your content. It has to be in the "
"future, and Pubsplash will not start a stream that is more than two "
"minutes late, so a schedule missed because the computer was asleep is "
"cancelled rather than going live to nobody."
msgstr ""

#. Context help for the Destinations for this source list.
#: help.toml
msgctxt "dialog.sends.busList"
msgid ""
"Everywhere this source can be heard: master output first, then every "
"bus. Arrow to a row and press SPACE to switch it on or off; each row "
"says whether it is on. Master output and the buses are independent, so "
"a source can go straight to master, through a bus, through several "
"buses, or any combination. Keeping master output checked alongside a "
"send is how you hear the dry signal as well as the effect: send a "
"reverb the full signal, then lower its send level to taste. Changes "
"take effect at once, so there is nothing to confirm."
msgstr ""

#. Context help for the Send level slider for one bus.
#: help.toml
msgctxt "dialog.sends.level"
msgid ""
"How much of this source is sent to the bus named in the slider, from 0 "
"to 100. There is one of these for each bus you have checked, and it "
"appears and disappears with that bus. Master output has none: its level "
"is the source's own volume on the mixer."
msgstr ""

#. Context help for the Incoming chat message checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.incomingChat"
msgid ""
"When checked, this source plays a sound each time a chat message "
"arrives from a listener."
msgstr ""

#. Context help for the Listener count decreased checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.listenerDecrease"
msgid ""
"When checked, this source plays a sound each time a listener leaves "
"your stream."
msgstr ""

#. Context help for the Listener count increased checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.listenerIncrease"
msgid ""
"When checked, this source plays a sound each time a new listener joins "
"your stream."
msgstr ""

#. Context help for the Listener peak increased checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.listenerPeakIncrease"
msgid ""
"When checked, this source plays a sound whenever your stream reaches a "
"new record for the most listeners at once."
msgstr ""

#. Context help for the Outgoing chat message checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.outgoingChat"
msgid ""
"When checked, this source plays a sound each time you send a chat "
"message of your own."
msgstr ""

#. Context help for the Send these sounds to the stream checkbox.
#: help.toml
msgctxt "dialog.soundEventsSource.toStream"
msgid ""
"This only controls whether your listeners hear these cues; you always "
"hear them yourself either way. Checked by default, so the cues are "
"mixed into the stream along with playing on your own speakers. Uncheck "
"it to keep them to yourself: they then never reach the stream or a "
"recording. Note that the copy you hear bypasses the mixer, so this "
"source's volume slider only affects what your listeners hear, though "
"muting the source silences the cues everywhere."
msgstr ""

#. Context help for the Sound event list.
#: help.toml
msgctxt "dialog.soundPreview.list"
msgid ""
"Every sound event Pubsplash has: the startup and shut-down cues, and "
"the five a Sound Events source can react to. Arrow to one and press "
"SPACE to hear what the chosen pack plays for it. SPACE on the event "
"that is already playing stops it; SPACE after arrowing to a different "
"one cuts the first sound off and plays the new one straight away, so "
"you can compare two events without waiting. A pack need not have a "
"sound for every event; if it has none for the one you picked, Pubsplash "
"says so rather than going quiet."
msgstr ""

#. Context help for the Play or stop button.
#: help.toml
msgctxt "dialog.soundPreview.play"
msgid ""
"Plays the sound for the event chosen in the list. It reads Stop instead "
"whenever pressing it would stop something, which is while the sound "
"playing is the one the list is sitting on; it goes back to reading Play "
"by itself once that sound ends, and also the moment you arrow to a "
"different event, since a press would then cut the first sound off and "
"play the new one. SPACE in the list above does the same thing without "
"leaving it."
msgstr ""

#. Context help for the Archive the stream checkbox.
#: help.toml
msgctxt "dialog.streamInfo.archive"
msgid ""
"When this is checked, your stream will be archived to Audiopub and "
"posted after it ends. If you'd like to control whether this happens "
"automatically for new streams, visit the archive tab under preferences."
msgstr ""

#. Context help for the Stream description input.
#: help.toml
msgctxt "dialog.streamInfo.description"
msgid ""
"Type a description for your live stream which appears under the title "
"on Audiopub."
msgstr ""

#. Context help for the Post periodic still-streaming announcements checkbox.
#: help.toml
msgctxt "dialog.streamInfo.mastodonPeriodic"
msgid ""
"When checked, Pubsplash posts a still-streaming reminder to Mastodon at "
"the interval set in Preferences, Mastodon, for as long as this stream "
"runs. Available only when a Mastodon account is linked."
msgstr ""

#. Context help for the Post to Mastodon when this stream starts checkbox.
#: help.toml
msgctxt "dialog.streamInfo.mastodonStart"
msgid ""
"When checked, Pubsplash posts to Mastodon once this stream is live. It "
"waits until the stream is really up, so the link in the post always "
"works. Available only when a Mastodon account is linked."
msgstr ""

#. Context help for the Stream audio quality (bitrate) choice.
#: help.toml
msgctxt "dialog.streamInfo.quality"
msgid ""
"Set the audio quality of your stream, a higher number means higher "
"quality. 128kbps is probably as low as you'd ever want to go with MP3."
msgstr ""

#. Context help for the Record this stream locally checkbox.
#: help.toml
msgctxt "dialog.streamInfo.record"
msgid ""
"When this is checked, your stream will be recorded and saved to disk. "
"If you'd like to control whether this happens automatically for new "
"streams, as well as customize where these recordings are saved, visit "
"the archive tab under preferences."
msgstr ""

#. Context help for the Stream title input.
#: help.toml
msgctxt "dialog.streamInfo.title"
msgid "Type the title of your stream here."
msgstr ""

#. Context help for the Azure style intensity.
#: help.toml
msgctxt "dialog.ttsSource.azureDegree"
msgid ""
"Set how strongly Azure applies the selected speaking style. One is the "
"voice's normal intensity; the allowed range is zero point zero one "
"through two. This control is unavailable while Default speaking style "
"is selected."
msgstr ""

#. Context help for the Azure speaking role.
#: help.toml
msgctxt "dialog.ttsSource.azureRole"
msgid ""
"Choose an optional character role supported by the selected Azure "
"voice. Default speaking role omits the role and leaves the voice "
"unchanged."
msgstr ""

#. Context help for the Azure speaking style.
#: help.toml
msgctxt "dialog.ttsSource.azureStyle"
msgid ""
"Choose an expressive style reported by the selected Azure voice, such "
"as cheerful or chat. Default speaking style omits the style setting."
msgstr ""

#. Context help for the ElevenLabs speaker boost.
#: help.toml
msgctxt "dialog.ttsSource.elevenBoost"
msgid ""
"Choose whether ElevenLabs speaker boost is left at the provider "
"default, explicitly turned on, or explicitly turned off. This setting "
"is unavailable for Eleven version 3."
msgstr ""

#. Context help for the ElevenLabs language code.
#: help.toml
msgctxt "dialog.ttsSource.elevenLanguage"
msgid ""
"Optionally enter a two-letter language code, such as en or fr, to "
"enforce pronunciation for models that support it. Leave blank to omit "
"the parameter."
msgstr ""

#. Context help for the ElevenLabs model.
#: help.toml
msgctxt "dialog.ttsSource.elevenModel"
msgid ""
"Choose an ElevenLabs model discovered with your validated credentials. "
"A saved model that is no longer reported remains available as an "
"unavailable legacy choice."
msgstr ""

#. Context help for the ElevenLabs similarity boost.
#: help.toml
msgctxt "dialog.ttsSource.elevenSimilarity"
msgid ""
"When Override similarity boost is checked, set how closely the output "
"should resemble the original voice, from zero through one. It is "
"unavailable for Eleven version 3."
msgstr ""

#. Context help for the ElevenLabs stability.
#: help.toml
msgctxt "dialog.ttsSource.elevenStability"
msgid ""
"When Override stability is checked, set consistency from zero through "
"one. Lower values are more expressive and variable; higher values are "
"more consistent."
msgstr ""

#. Context help for the Stream ElevenLabs audio.
#: help.toml
msgctxt "dialog.ttsSource.elevenStream"
msgid ""
"When checked, speech begins playing as ElevenLabs generates it instead "
"of waiting for the whole message, which noticeably shortens the delay "
"before a chat message is read. Uncheck it to wait for the complete "
"clip. It is unavailable for Eleven version 3, which has no streaming "
"endpoint."
msgstr ""

#. Context help for the ElevenLabs style exaggeration.
#: help.toml
msgctxt "dialog.ttsSource.elevenStyle"
msgid ""
"When Override style exaggeration is checked, set the strength of the "
"voice's learned style from zero through one. Leave the override "
"unchecked to omit this parameter."
msgstr ""

#. Context help for the TTS engine choice.
#: help.toml
msgctxt "dialog.ttsSource.engine"
msgid ""
"Use arrow keys and first letter navigation to select a TTS engine. "
"Arrow through as fast as you like: the voice list is reloaded a moment "
"after you stop, or straight away when you tab out of this box, so "
"passing over engines on the way costs nothing."
msgstr ""

#. Context help for the Google Cloud audio effects profile.
#: help.toml
msgctxt "dialog.ttsSource.googleEffect"
msgid ""
"Optionally optimize Google Cloud speech for a playback device, such as "
"headphones, a telephone, a Bluetooth speaker, a car, or a home "
"entertainment system. No effects profile omits the parameter."
msgstr ""

#. Context help for the Google Cloud language code.
#: help.toml
msgctxt "dialog.ttsSource.googleLanguage"
msgid ""
"Enter a Google Cloud language code such as en dash US. Leave blank to "
"infer the language from the selected voice name."
msgstr ""

#. Context help for the Google Translate speed mode.
#: help.toml
msgctxt "dialog.ttsSource.gttsSpeed"
msgid ""
"Choose the Google Translate endpoint's normal or slow speech mode. "
"Provider default omits your preference and currently behaves as normal "
"speed."
msgstr ""

#. Context help for the Google Translate accent domain.
#: help.toml
msgctxt "dialog.ttsSource.gttsTld"
msgid ""
"Enter the Google domain suffix used to select a regional accent, such "
"as co.uk or com.au. Leave blank for com. Invalid host characters are "
"rejected before a request is sent."
msgstr ""

#. Context help for the OpenAI voice instructions.
#: help.toml
msgctxt "dialog.ttsSource.openaiInstructions"
msgid ""
"Describe how the OpenAI voice should speak, such as warm, calm, or "
"energetic. Instructions are sent only with GPT-4o mini TTS models and "
"omitted for TTS 1 models."
msgstr ""

#. Context help for the OpenAI speech model.
#: help.toml
msgctxt "dialog.ttsSource.openaiModel"
msgid ""
"Choose an OpenAI speech model discovered with your validated "
"credentials. Saved legacy models remain selectable when unavailable."
msgstr ""

#. Context help for the TTS voice pitch slider.
#: help.toml
msgctxt "dialog.ttsSource.pitch"
msgid ""
"Use arrows, page up, page down, home and end to set the pitch of this "
"voice. Only Microsoft Edge, Azure, and Google Cloud support pitch; for "
"other engines this control is announced as unsupported and has no "
"effect."
msgstr ""

#. Context help for the Polly engine.
#: help.toml
msgctxt "dialog.ttsSource.pollyEngine"
msgid ""
"Choose the AWS Polly synthesis engine for this source: standard, "
"neural, long-form, or generative. Provider default omits the parameter "
"and uses standard. Pitch is available only with standard."
msgstr ""

#. Context help for the Polly language code.
#: help.toml
msgctxt "dialog.ttsSource.pollyLanguage"
msgid ""
"Optionally enter the Polly language code for a bilingual voice. Leave "
"blank to let the selected voice determine its language."
msgstr ""

#. Context help for the Preview voice button.
#: help.toml
msgctxt "dialog.ttsSource.preview"
msgid ""
"Press to hear a test phrase with the current engine, voice, rate, "
"volume, and pitch. The preview plays only to you and never reaches the "
"stream. If synthesis fails, the reason is shown here, which is the "
"quickest way to check an API key."
msgstr ""

#. Context help for the TTS speech rate slider.
#: help.toml
msgctxt "dialog.ttsSource.rate"
msgid ""
"Use arrows, page up, page down, home and end to set the rate of the "
"speech."
msgstr ""

#. Context help for the Reset this engine to defaults button.
#: help.toml
msgctxt "dialog.ttsSource.reset"
msgid ""
"Puts the engine currently selected above back to its default voice, "
"volume, rate, pitch and provider settings. Only that engine is reset; "
"every other engine keeps what you have set for it. Nothing is saved "
"until you press OK, so cancel undoes the reset."
msgstr ""

#. Context help for the Send speech to the stream checkbox.
#: help.toml
msgctxt "dialog.ttsSource.toStream"
msgid ""
"When this is checked, speech is mixed into the outgoing stream so your "
"listeners hear it. When it is not, the speech reaches neither the "
"stream nor any bus this source sends to. Either way you hear it "
"yourself: speech is always played to you, whichever engine it comes "
"from, and you do not need to monitor this source to hear it."
msgstr ""

#. Context help for the TTS voice choice.
#: help.toml
msgctxt "dialog.ttsSource.voice"
msgid ""
"Use arrow keys and first letter navigation to choose the tts voice for "
"this engine. This box reports how many voices are available, or says "
"they have not been fetched yet; the same line appears below it. Default "
"voice leaves the choice to the engine."
msgstr ""

#. Context help for the TTS voice volume slider.
#: help.toml
msgctxt "dialog.ttsSource.volume"
msgid ""
"Use arrows, page up, page down, home and end to set the volume of this "
"voice."
msgstr ""

#. Context help for the Cancel the update download button.
#: help.toml
msgctxt "dialog.update.cancel"
msgid ""
"Stops the download and closes this window. Nothing on your computer has "
"been changed at this point, so cancelling is always safe; the part that "
"was downloaded is thrown away. You can start the update again later "
"from the General tab of Preferences."
msgstr ""

#. Context help for the Update download progress bar.
#: help.toml
msgctxt "dialog.update.progress"
msgid ""
"How much of the update has been downloaded so far, as a percentage. It "
"reaches one hundred percent when the download is complete and Pubsplash "
"starts checking it."
msgstr ""

#. Context help for the Update download status text.
#: help.toml
msgctxt "dialog.update.status"
msgid ""
"How far the download has got, in megabytes. This is a read-only box you "
"can tab to and read whenever you like; it does not read itself out as "
"it changes, so it won't talk over you while you work."
msgstr ""

#. Context help for the Refresh account balances button.
#: help.toml
msgctxt "tab.api.refreshButton"
msgid ""
"Ask each provider that publishes one how much credit is left on your "
"account. Only ElevenLabs reports a balance; the others are marked "
"unavailable. This is never done automatically, so pressing it is the "
"only thing that spends a request on your behalf."
msgstr ""

#. Context help for the Per-engine API usage list.
#: help.toml
msgctxt "tab.api.usageList"
msgid ""
"What each speech engine has been asked to do since Pubsplash started, "
"most recently used engine first. Only engines that have actually spoken "
"appear. Each engine's name is followed by its indented figures: "
"requests sent, characters sent, credits spent, remaining balance, "
"models used, voices used, and failures. Anything the provider does not "
"report reads as unavailable. Use arrows, page up, page down, home, and "
"end to navigate this list."
msgstr ""

#. Context help for the Add bus button.
#: help.toml
msgctxt "tab.buses.busAdd"
msgid ""
"Create a new bus. Buses hold effects and output to master. You decide "
"what sources send their output to which buses,, how much of their "
"signal to send, and whether they should output to master as well as to "
"the bus."
msgstr ""

#. Context help for the Move bus down button.
#: help.toml
msgctxt "tab.buses.busDown"
msgid ""
"Move the selected bus down in the list. CTRL+Down will also work as "
"long as focus is on the list of buses."
msgstr ""

#. Context help for the Buses list (row 0 is the master output).
#: help.toml
msgctxt "tab.buses.busList"
msgid ""
"This is the list of buses, use arrow keys, page up, page down, home, "
"and end to select one to work with. Use CTRL+arrows to move the "
"selected bus up or down in the list."
msgstr ""

#. Context help for the Remove bus button.
#: help.toml
msgctxt "tab.buses.busRemove"
msgid "Deletes the selected bus. Note that you cannot delete master."
msgstr ""

#. Context help for the Rename bus button.
#: help.toml
msgctxt "tab.buses.busRename"
msgid "Renames the selected bus."
msgstr ""

#. Context help for the Move bus up button.
#: help.toml
msgctxt "tab.buses.busUp"
msgid ""
"Move the selected bus up in the list. CTRL+up will also work as long as "
"focus is on the list of buses."
msgstr ""

#. Context help for the Export FX chain file button.
#: help.toml
msgctxt "tab.buses.chainExport"
msgid ""
"Export the selected FX chain to a file where it can be imported for use "
"on another machine."
msgstr ""

#. Context help for the Import FX chain file button.
#: help.toml
msgctxt "tab.buses.chainImport"
msgid ""
"Select an FX chain file to add to your master list of chains. It will "
"then become usable."
msgstr ""

#. Context help for the Add plugin to chain button.
#: help.toml
msgctxt "tab.buses.fxAdd"
msgid ""
"Add a plugin to the FX chain for the selected bus. Plugins are "
"processed from the top down, so order matters."
msgstr ""

#. Context help for the Move plugin down in chain button.
#: help.toml
msgctxt "tab.buses.fxDown"
msgid ""
"Move the selected plugin down in the selected chain. CTRL+Down will "
"also work as long as focus is on the list of plugins."
msgstr ""

#. Context help for the Effects chain on the selected bus.
#: help.toml
msgctxt "tab.buses.fxList"
msgid ""
"This is the list of effects on the selected bus. Use arrow keys, page "
"up, page down, home, and end to select an effect. CTRL+Up and CTRL+Down "
"move the selected effect. Since effects process from top to bottom, "
"order matters!."
msgstr ""

#. Context help for the Open plugin interface button.
#: help.toml
msgctxt "tab.buses.fxOpenInterface"
msgid ""
"If a plugin has an accessible interface, pressing this button will open "
"it. From there, you can press F6 to try to focus the window and use "
"standard controls to work with it. If you know the plugin doesn't have "
"an accessible interface, it's better to use the edit parameters button "
"instead."
msgstr ""

#. Context help for the Remove plugin from chain button.
#: help.toml
msgctxt "tab.buses.fxRemove"
msgid "Remove the selected plugin from the FX chain."
msgstr ""

#. Context help for the Move plugin up in chain button.
#: help.toml
msgctxt "tab.buses.fxUp"
msgid ""
"Move the selected plugin up in the chain. CTRL+Up will also work as "
"long as focus is on the list of plugins."
msgstr ""

#. Context help for the Chat message input box.
#: help.toml
msgctxt "tab.chat.input"
msgid "Type a message and press ENTER to chat to your stream."
msgstr ""

#. Context help for the Chat message list.
#: help.toml
msgctxt "tab.chat.messageList"
msgid ""
"All chats you receive while streaming can be viewed here. Use arrows, "
"page up, page down, home, and end to navigate this list."
msgstr ""

#. Context help for the Reconnect chat feed button.
#: help.toml
msgctxt "tab.chat.reconnectButton"
msgid ""
"Open a fresh connection to the chat feed without interrupting your "
"stream. Pubsplash reconnects on its own when it notices the feed has "
"gone quiet, so you should rarely need this; use it if chat has stopped "
"arriving and you would rather not wait. Your audio keeps going out "
"either way."
msgstr ""

#. Context help for the Send chat message button.
#: help.toml
msgctxt "tab.chat.sendButton"
msgid "Press this button to send your message."
msgstr ""

#. Context help for the View selected message button.
#: help.toml
msgctxt "tab.chat.viewButton"
msgid ""
"View the selected chat in a box that will allow for standard text "
"navigation, selection, and copying."
msgstr ""

#. Context help for the Mixer strip open file button.
#: help.toml
msgctxt "tab.home.mixer.strip.openFile"
msgid ""
"Plays one file of your choosing on this media player. The file can be "
"anywhere on your computer and does not have to be in the source's "
"folder. It interrupts whatever is playing, exactly as skipping to the "
"next track does, and when it finishes the folder carries on with the "
"track it was going to play next. Nothing about the file is remembered. "
"This button only appears on a media player's strip."
msgstr ""

#. Context help for the Mixer strip volume slider.
#: help.toml
msgctxt "tab.home.mixer.strip.volume"
msgid ""
"Sets this strip's level, from 0 to 100 percent, where 100 is unity "
"gain. Up, right, and page up raise the volume; down, left, and page "
"down lower it. Arrows step by 1 percent and page keys by 10. Home jumps "
"to the maximum and end to silence. If a source is too quiet even at 100 "
"percent, open the context menu with shift plus F10, the applications "
"key, or a right click, and choose Enable volume boost: the slider then "
"goes up to 500 percent, amplifying the signal. Turning volume boost "
"back off snaps the slider down to 100 percent."
msgstr ""

#. Context help for the Stream overview list.
#: help.toml
msgctxt "tab.home.overview"
msgid ""
"A read-only list of the current state of your broadcast, one fact per "
"row. The status row is always there and tells you whether you're "
"streaming, recording, or both. While you're streaming, quality, "
"listener, and listener peak rows appear below it; quality is the "
"bitrate and format going out to your listeners. Whenever a stream or a "
"recording is running, a duration row shows how long it has been going. "
"That row counts up in the background, but the row you have selected is "
"left alone until you go to it, so nothing in this list ever reads "
"itself out at you. It's brought up to date the moment before you'd hear "
"it: arrow onto the row, or tab into the list, and it reads the time as "
"it is now, once."
msgstr ""

#. Context help for the Start/stop recording button.
#: help.toml
msgctxt "tab.home.recordButton"
msgid ""
"Start or stop local recording. Note: You can't use this button if "
"you're already streaming. If you'd like to record a stream, this can be "
"done by checking the appropriate box in File > set stream info."
msgstr ""

#. Context help for the Scenes list.
#: help.toml
msgctxt "tab.home.sceneList"
msgid ""
"Select a scene and press the switch button to transition to it. The "
"order your scenes appear is the order they're set to in the scenes tab."
msgstr ""

#. Context help for the Start/stop streaming button.
#: help.toml
msgctxt "tab.home.streamButton"
msgid ""
"Starts or stops streaming to Audio Pub. Note: This button will be "
"unavailable if you've started a local recording."
msgstr ""

#. Context help for the Switch to scene button.
#: help.toml
msgctxt "tab.home.switchScene"
msgid "Transition to the selected scene."
msgstr ""

#. Context help for the Add scene button.
#: help.toml
msgctxt "tab.scenes.sceneAdd"
msgid ""
"Create a new scene which allows you to organize your sources by how you "
"intend to use them. Scenes can be switched on the home tab. The default "
"scene is always here and can be renamed, but not deleted."
msgstr ""

#. Context help for the Move scene down button.
#: help.toml
msgctxt "tab.scenes.sceneDown"
msgid ""
"Move the selected scene down in the list. CTRL+Down will also work as "
"long as focus is on the list of scenes."
msgstr ""

#. Context help for the Scenes list.
#: help.toml
msgctxt "tab.scenes.sceneList"
msgid ""
"This is a list of configured scenes. Use the arrows, page up, page "
"down, home, and end to navigate it. CTRL+Up and CTRL+Down will move the "
"selected scene in the list. You transition between scenes via the list "
"on the home tab. The order of the scenes on the home tab mirrors the "
"order here, so configure them to suit your preference."
msgstr ""

#. Context help for the Rename scene button.
#: help.toml
msgctxt "tab.scenes.sceneRename"
msgid "Rename the selected scene."
msgstr ""

#. Context help for the Move scene up button.
#: help.toml
msgctxt "tab.scenes.sceneUp"
msgid ""
"Move the selected scene up in the list. CTRL+Up will also work as long "
"as focus is on the list of scenes."
msgstr ""

#. Context help for the Add source button.
#: help.toml
msgctxt "tab.scenes.sourceAdd"
msgid ""
"Add a new source to the selected scene. A source is something your "
"stream will hear, such as your microphone, an app, a tts engine, etc."
msgstr ""

#. Context help for the Move source down button.
#: help.toml
msgctxt "tab.scenes.sourceDown"
msgid ""
"Move the selected source down in the list. CTRL+Down will also work as "
"long as focus is on the list of sources."
msgstr ""

#. Context help for the Edit source button.
#: help.toml
msgctxt "tab.scenes.sourceEdit"
msgid ""
"Edit this source; what this does depends on the source. If it's a "
"microphone source, it sets the mic to use, if it's a tts source, it "
"sets the voice and parameters."
msgstr ""

#. Context help for the Sources list for the selected scene.
#: help.toml
msgctxt "tab.scenes.sourceList"
msgid ""
"Use the arrow keys, page up, page down, home, and end to select a "
"source to work with. CTRL+Up and CTRL+Down can be used to move the "
"selected source in the list."
msgstr ""

#. Context help for the Remove source button.
#: help.toml
msgctxt "tab.scenes.sourceRemove"
msgid "Delete the selected source."
msgstr ""

#. Context help for the Source sends button.
#: help.toml
msgctxt "tab.scenes.sourceSends"
msgid ""
"Set up one or more buses you'd like to send this source's signal to. "
"This is how you add effects. You send the source to a bus, put the "
"effects on the bus and voila!"
msgstr ""

#. Context help for the Move source up button.
#: help.toml
msgctxt "tab.scenes.sourceUp"
msgid ""
"Move the selected source up in the list. CTRL+Up will also work as long "
"as focus is on the list of sources."
msgstr ""

#. Context help for the Main tab bar.
#: help.toml
msgctxt "window.tabBar"
msgid ""
"The tabs of the main window: Home, Chat, Scenes and Sources, and Buses. "
"Use the left and right arrow keys to move between tabs, then TAB to go "
"into the tab's contents. From anywhere in a tab, F6 jumps forward to "
"the next list, and on past the last one back here to the tabs; SHIFT+F6 "
"goes the other way."
msgstr ""

